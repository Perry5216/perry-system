{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "references": [
    { "path": "packages/core" },
    { "path": "packages/ai" },
    { "path": "packages/rag" },
    { "path": "packages/projects" },
    { "path": "packages/export" },
    { "path": "packages/dashboard-api" }
  ],
  "files": []
}
